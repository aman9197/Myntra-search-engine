# -----------------------------------------------------------------------------
# Myntra AI Discovery Engine — Production Git Ignore Specification
# Prevents secret leaks, build bloat, and deployment blocking on GitHub & Vercel
# -----------------------------------------------------------------------------

# Dependencies & Package Managers
node_modules/
/node_modules/
.npm/
.yarn/
.pnpm-store/

# Python Cache & Virtual Environments (if helper scripts run locally)
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
venv/
.venv/
env/

# Environment Variables & Secret Credentials (NEVER commit secrets to GitHub)
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
*.pem
*.key
id_rsa
secrets.json

# Vercel & Deployment Build Output Metadata
.vercel/
dist/
build/
.next/
.out/

# Operating System & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Log Files & Debugging Artifacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

